# EduVerify Environment Variables Example
# Copy to .env for local development

# Environment (dev, staging, prod)
ENV=dev
PORT=8000

# Database (PostgreSQL 16 in prod/Docker, SQLite supported locally)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/eduverify

# Security Keys
# Generate JWT_SECRET: openssl rand -hex 32
JWT_SECRET=dev-jwt-secret-at-least-32-characters-for-hs256-signing-eduverify
# Generate FERNET_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=0123456789abcdef0123456789abcdef0123456789a=
# Ed25519 issuer private keys for SD-JWT Verifiable Credentials (JSON formatted)
ISSUER_KEYS_JSON={}
PEPPER=dev-password-pepper-change-in-production
SEED_PASSWORD=AdminPassword@2026

# CORS & Base URLs
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
FRONTEND_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:8000

# Notifications & SMTP (Mailpit runs on port 1025 locally, UI at 8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@eduverify.aicte-india.org
