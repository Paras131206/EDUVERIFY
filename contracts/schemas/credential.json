{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eduverify.aicte-india.org/schemas/credential.json",
  "title": "VerifiableCredential",
  "description": "SD-JWT VC and verification schemas for EduVerify per agents.md §8.2, §8.3, §8.4",
  "type": "object",
  "definitions": {
    "ConfirmationKey": {
      "type": "object",
      "required": ["jwk"],
      "properties": {
        "jwk": {
          "type": "object",
          "required": ["kty", "crv", "x", "y"],
          "properties": {
            "kty": { "type": "string", "enum": ["EC"] },
            "crv": { "type": "string", "enum": ["P-256"] },
            "x": { "type": "string" },
            "y": { "type": "string" }
          }
        }
      }
    },
    "StatusListRef": {
      "type": "object",
      "required": ["uri", "idx", "status_type"],
      "properties": {
        "uri": { "type": "string", "format": "uri" },
        "idx": { "type": "integer", "minimum": 0 },
        "status_type": { "type": "string", "enum": ["revocation", "suspension"] }
      }
    },
    "CredentialSubject": {
      "type": "object",
      "required": [
        "apaar_id",
        "institution_aicte_id",
        "institution_student_id",
        "full_name",
        "program_code",
        "course_level",
        "academic_year",
        "enrolment_status"
      ],
      "properties": {
        "apaar_id": { "type": "string", "pattern": "^\\d{12}$" },
        "institution_aicte_id": { "type": "string" },
        "institution_name": { "type": "string" },
        "institution_student_id": { "type": "string" },
        "full_name": { "type": "string" },
        "dob": { "type": "string", "format": "date" },
        "gender": { "type": "string", "enum": ["M", "F", "T"] },
        "program_code": { "type": "string" },
        "program_name": { "type": "string" },
        "course_level": { "type": "string", "enum": ["DIPLOMA", "UG", "PG", "PGDM", "PHD"] },
        "department": { "type": "string" },
        "academic_year": { "type": "string" },
        "admission_date": { "type": "string", "format": "date" },
        "enrolment_status": { "type": "string", "enum": ["ACTIVE", "WITHDRAWN", "DEFERRED", "TRANSFERRED_OUT", "COMPLETED", "GRADUATED"] },
        "credential_type": { "type": "string", "enum": ["ENROLMENT_CREDENTIAL", "DEGREE_CERTIFICATE"] },
        "record_version": { "type": "integer", "minimum": 1 }
      }
    },
    "SDJWTPayload": {
      "type": "object",
      "required": ["iss", "sub", "iat", "vct", "cnf", "status"],
      "properties": {
        "iss": { "type": "string", "description": "Issuer DID (e.g. did:web:...)" },
        "sub": { "type": "string", "description": "Subject identifier (e.g. apaar_id)" },
        "iat": { "type": "integer", "description": "Issued at epoch timestamp" },
        "exp": { "type": "integer", "description": "Expires at epoch timestamp" },
        "vct": { "type": "string", "description": "Verifiable Credential Type identifier" },
        "cnf": { "$ref": "#/definitions/ConfirmationKey" },
        "status": { "$ref": "#/definitions/StatusListRef" },
        "_sd": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Array of SHA-256 hashes of selectively disclosable digests"
        },
        "_sd_alg": { "type": "string", "default": "sha-256" }
      }
    },
    "PresentationRequest": {
      "type": "object",
      "required": ["sd_jwt_presentation"],
      "properties": {
        "sd_jwt_presentation": {
          "type": "string",
          "description": "Combined presentation string: <Issuer-JWT>~<Disclosure-1>~...~<Disclosure-N>~<KB-JWT>"
        },
        "nonce": { "type": "string", "description": "Challenge nonce from verifier" },
        "aud": { "type": "string", "description": "Verifier audience URI" }
      }
    },
    "VerificationResult": {
      "type": "object",
      "required": ["valid", "status", "issuer", "verified_at"],
      "properties": {
        "valid": { "type": "boolean" },
        "status": { "type": "string", "enum": ["VALID", "REVOKED", "SUPERSEDED", "SUSPENDED", "INVALID_SIGNATURE", "EXPIRED", "KEY_BINDING_FAILED"] },
        "issuer": { "type": "string" },
        "issuer_trusted": { "type": "boolean" },
        "verified_at": { "type": "string", "format": "date-time" },
        "disclosed_claims": { "type": "object" },
        "error_message": { "type": "string" }
      }
    }
  }
}
